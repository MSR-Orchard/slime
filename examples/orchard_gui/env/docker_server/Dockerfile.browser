# ==========================================================================
# Browser Environment Server Docker Image
#
# Serves N browser environments via HTTP for slime training/rollout.
#
# Build (from slime-private root):
#   docker build -f examples/orchard_gui/env/docker_server/Dockerfile.browser -t browser-env .
#
# Run:
#   docker run -p 8100:8100 -e NUM_BROWSER_ENVS=4 --shm-size=2g browser-env
# ==========================================================================

FROM python:3.10-slim

# ---- System dependencies for Playwright / Chromium ----
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        curl \
        gnupg \
        ca-certificates \
        fonts-liberation \
        libnss3 \
        libatk-bridge2.0-0 \
        libdrm2 \
        libxkbcommon0 \
        libgbm1 \
        libasound2 \
        libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Python dependencies ----
# NOTE: qwen_vl_utils is NOT installed here because it pulls in torch (~2GB).
# The smart_resize import is lazy and only triggered when resize_scale <= 0,
# which the default config does not use.
RUN pip install --no-cache-dir \
        fastapi \
        uvicorn[standard] \
        pyyaml \
        playwright \
        timeout-decorator

# Install Chromium for Playwright
RUN playwright install --with-deps chromium

# ---- Copy only the browser env code (no slime / torch dependency) ----

# Package structure so "from examples.orchard_gui.env.web_env import WebEnv" works
RUN mkdir -p /app/examples/orchard_gui/env/utils /app/examples/orchard_gui/env/docker_server

# __init__.py files (empty stubs – the server doesn't need the full package)
RUN touch /app/examples/__init__.py \
          /app/examples/orchard_gui/__init__.py \
          /app/examples/orchard_gui/env/__init__.py \
          /app/examples/orchard_gui/env/docker_server/__init__.py \
          /app/examples/orchard_gui/env/utils/__init__.py

# Core env files
COPY examples/orchard_gui/env/base_env.py       /app/examples/orchard_gui/env/base_env.py
COPY examples/orchard_gui/env/web_env.py        /app/examples/orchard_gui/env/web_env.py
COPY examples/orchard_gui/env/utils/js.py       /app/examples/orchard_gui/env/utils/js.py
COPY examples/orchard_gui/env/utils/keyboard.py /app/examples/orchard_gui/env/utils/keyboard.py

# Config, prompts, and tasks
# COPY examples/orchard_gui/env/config.yaml       /app/examples/orchard_gui/env/config.yaml
# COPY examples/orchard_gui/env/prompts/          /app/examples/orchard_gui/env/prompts/
# COPY examples/orchard_gui/env/tasks/            /app/examples/orchard_gui/env/tasks/

# Server entry point
COPY examples/orchard_gui/env/docker_server/env_server.py  /app/examples/orchard_gui/env/docker_server/env_server.py

# ---- Runtime config ----
ENV PYTHONPATH=/app
ENV NUM_BROWSER_ENVS=1

EXPOSE 8100

# Run the server
CMD ["python", "-m", "examples.orchard_gui.env.docker_server.env_server", "--host", "0.0.0.0", "--port", "8100"]
