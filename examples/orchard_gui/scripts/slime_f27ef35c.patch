+def append_progress_log(args, line: str, filename: str = "progress.log") -> None:
+    """Append a single human-readable progress line to ``<save>/progress.log``.
+
+    Best-effort: no-op when ``--save`` is unset, and never raises into the caller.
+    """
+    save_dir = getattr(args, "save", None)
+    if not save_dir:
+        return
+
+    path = Path(save_dir) / filename
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with path.open("a", encoding="utf-8") as f:
