diff --git a/slime/ray/rollout.py b/slime/ray/rollout.py
index be8f4243..ff46802c 100644
--- a/slime/ray/rollout.py
+++ b/slime/ray/rollout.py
@@ -102,6 +102,113 @@ def _tensorize_rollout_data_for_training(rollout_data: dict[str, Any]) -> None:
             dtype=torch.float32,
         )
 
+def _has_turn_metadata(sample: Sample) -> bool:
+    metadata = sample.metadata or {}
+    return "turn_index" in metadata or "is_last_turn" in metadata
+
+
+def _turn_index(sample: Sample) -> int | None:
+    metadata = sample.metadata or {}
+    if "turn_index" not in metadata:
+        return None
+    try:
+        return int(metadata["turn_index"])
+    except (TypeError, ValueError):
+        return None
+
+
+def _trajectory_metric_sample_indices(samples: list[Sample], rollout_ids: list[int] | None = None) -> list[int]:
+    """Return one metric representative per turn-level trajectory.
+
+    Browser-agent rollouts can flatten one browser episode into many trainable turn samples.
+    Those sibling turns share one rollout id, so trajectory-level eval metrics should count
+    only the final turn for that episode. Ordinary non-turn samples are returned unchanged.
+    """
+    if not samples:
+        return []
+
+    groups: dict[Any, list[int]] = {}
+    rollout_order = []
+    for i, sample in enumerate(samples):
+        # Prefer the resolved rollout id from training data when available.
+        # Eval samples use Sample.rollout_id, falling back to Sample.index for the default one-sample-per-rollout path.
+        if rollout_ids is not None:
+            rid = rollout_ids[i]
+        elif sample.rollout_id is not None:
+            rid = sample.rollout_id
+        elif sample.index is not None:
+            rid = sample.index
+        else:
+            rid = i
+
+        if rid not in groups:
+            groups[rid] = []
+            rollout_order.append(rid)
+        groups[rid].append(i)
+
+    indices = []
+    for rid in rollout_order:
+        group_indices = groups[rid]
+        # Shared rollout_id alone is not enough to collapse a group: other compact rollout functions may
+        # emit multiple non-turn samples.
+        # Only browser-style turn metadata enables one-representative selection.
+        if not any(_has_turn_metadata(samples[i]) for i in group_indices):
+            indices.extend(group_indices)
+            continue
+
+        def selection_key(pos: int) -> tuple[bool, bool, int, int]:
+            turn_index = _turn_index(samples[pos])
+            return (
+                bool((samples[pos].metadata or {}).get("is_last_turn")),
+                turn_index is not None,
+                turn_index if turn_index is not None else -1,
+                pos,
+            )
+
+        # Selection priority: explicit is_last_turn, then largest turn_index,
+        # then latest flattened position as a defensive fallback.
+        indices.append(max(group_indices, key=selection_key))
+
+    return indices
+
+
+def _post_process_turn_level_rewards(args: Any, samples: list[Sample], raw_rewards: list[float]) -> list[float] | None:
+    """Normalize trajectory rewards by prompt group and broadcast them to turn samples.
+
+    Browser-agent rollout flattens one trajectory into several turn-level samples.
