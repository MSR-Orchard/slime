diff --git a/slime/backends/megatron_utils/megatron_patch/gdn_packed_seq_patch.py b/slime/backends/megatron_utils/megatron_patch/gdn_packed_seq_patch.py
new file mode 100644
index 00000000..dc0795ef
--- /dev/null
+++ b/slime/backends/megatron_utils/megatron_patch/gdn_packed_seq_patch.py
@@ -0,0 +1,164 @@
+# Patch megatron.core.ssm.gated_delta_net.GatedDeltaNet to support packed
+# (THD / variable-length) sequences during training.
+#
+# Stock Megatron raises `NotImplementedError("GDN does not support packed
+# sequence for now.")` whenever `packed_seq_params` is set. But the two FLA
+# primitives GDN already uses both accept a `cu_seqlens` argument that handles
+# variable-length packed input correctly (resetting the conv state and the
+# delta-rule recurrent state at each sequence boundary):
+#   - fla.modules.convolution.causal_conv1d(..., cu_seqlens=...)
+#   - fla.ops.gated_delta_rule.chunk_gated_delta_rule(..., cu_seqlens=...)
+#
+# slime already builds the correct `cu_seqlens` in the THD `PackedSeqParams`
+# (see slime/backends/megatron_utils/data.py). This patch threads that tensor
+# into the two FLA calls and removes the hard raise, without touching any
+# Megatron-LM file.
+#
+# Scope / assumptions:
+#   - Context parallelism is NOT supported in the packed path here (cp_size==1).
+#     With CP>1 GDN splits/all-to-alls the sequence across CP ranks, so the
+#     cu_seqlens<->token alignment would need extra handling that this patch
+#     does not implement. We assert rather than silently produce wrong grads.
+#   - deterministic_mode uses a plain F.conv1d (not FLA causal_conv1d) which
+#     cannot honor cu_seqlens, so conv state would bleed across packed
+#     sequence boundaries. We refuse the packed path in that mode.
+#   - Sequence parallel (SP) is fine: in_proj all-gathers the sequence before
+#     the conv/recurrence, so cu_seqlens (full-sequence boundaries) line up.
+
+import contextvars
+import logging
+import warnings
+
+logger = logging.getLogger(__name__)
+
+# Holds the cu_seqlens for the GDN forward currently executing in this process.
+# Set by the patched forward, read by the wrapped FLA primitives. None outside
+# a packed forward, in which case the wrappers behave exactly like the originals.
+_CU_SEQLENS = contextvars.ContextVar("slime_gdn_cu_seqlens", default=None)
+
+
+def _inject_cu_seqlens(fn):
+    """Wrap an FLA primitive so it picks up cu_seqlens from the context var
+    unless the caller already passed one explicitly."""
+
+    def wrapped(*args, **kwargs):
+        if kwargs.get("cu_seqlens") is None:
+            cu = _CU_SEQLENS.get()
+            if cu is not None:
+                kwargs["cu_seqlens"] = cu
+        return fn(*args, **kwargs)
+
+    return wrapped
+
+
+try:
+    from megatron.core.ssm import gated_delta_net as _gdn
+
+    if not getattr(_gdn, "_slime_packed_seq_patched", False):
+        if not getattr(_gdn, "HAVE_FLA", False):
+            # GDN itself raises on construction without FLA, so this patch is
+            # only meaningful when FLA is present.
+            raise ImportError("FLA not available; GDN packed-seq patch skipped.")
+
+        # Wrap the module-level FLA primitives. `causal_conv1d` is looked up as a
+        # module global inside forward(), so patching the module attribute is
+        # enough for it. The delta-rule fns are bound onto the instance in
+        # __init__ (self.gated_delta_rule = ...); we re-bind in patched __init__
+        # below so already/late-constructed instances both get the wrapper.
+        _gdn.causal_conv1d = _inject_cu_seqlens(_gdn.causal_conv1d)
+        _wrapped_chunk = _inject_cu_seqlens(_gdn.chunk_gated_delta_rule)
+        _wrapped_torch_chunk = _inject_cu_seqlens(_gdn.torch_chunk_gated_delta_rule)
+        _gdn.chunk_gated_delta_rule = _wrapped_chunk
+        _gdn.torch_chunk_gated_delta_rule = _wrapped_torch_chunk
+
+        GatedDeltaNet = _gdn.GatedDeltaNet
+        _orig_init = GatedDeltaNet.__init__
+        _orig_forward = GatedDeltaNet.forward
+
+        def _patched_init(self, *args, **kwargs):
+            _orig_init(self, *args, **kwargs)
+            # Re-bind to the cu_seqlens-injecting wrapper regardless of which
+            # backend __init__ picked (deterministic torch vs triton).
+            if self.config.deterministic_mode:
+                self.gated_delta_rule = _wrapped_torch_chunk
+            else:
+                self.gated_delta_rule = _wrapped_chunk
+
+        def _patched_forward(
+            self,
+            hidden_states,
+            attention_mask,
+            inference_context=None,
+            packed_seq_params=None,
+            sequence_len_offset=None,
+            *,
+            inference_params=None,
+            **kwargs,
+        ):
+            if packed_seq_params is None:
+                return _orig_forward(
+                    self,
+                    hidden_states,
+                    attention_mask,
+                    inference_context=inference_context,
+                    packed_seq_params=None,
+                    sequence_len_offset=sequence_len_offset,
+                    inference_params=inference_params,
+                    **kwargs,
+                )
+
+            # Packed / THD path.
+            assert self.cp_size == 1, (
+                "Packed-sequence GDN training is only supported with "
+                f"context-parallel-size == 1 (got cp_size={self.cp_size}). "
+                "Disable CP or use --qkv-format bshd for GDN models under CP."
+            )
+            assert not self.config.deterministic_mode, (
+                "Packed-sequence GDN training is incompatible with "
+                "deterministic_mode: the deterministic conv1d path cannot reset "
+                "state at sequence boundaries. Disable deterministic_mode or use "
+                "--qkv-format bshd."
+            )
+
+            cu_seqlens = packed_seq_params.cu_seqlens_q
+            # FLA varlen kernels expect int32 cu_seqlens; slime builds them as
+            # torch.int already, but be defensive.
+            if cu_seqlens.dtype != _gdn.torch.int32:
+                cu_seqlens = cu_seqlens.to(_gdn.torch.int32)
+
+            token = _CU_SEQLENS.set(cu_seqlens)
+            try:
+                # Pass packed_seq_params=None so the original body does not hit
+                # the hard raise; the wrapped FLA primitives pick up cu_seqlens
+                # from the context var instead.
+                return _orig_forward(
+                    self,
+                    hidden_states,
+                    attention_mask,
+                    inference_context=inference_context,
+                    packed_seq_params=None,
+                    sequence_len_offset=sequence_len_offset,
+                    inference_params=inference_params,
+                    **kwargs,
+                )
+            finally:
+                _CU_SEQLENS.reset(token)
+
+        GatedDeltaNet.__init__ = _patched_init
+        GatedDeltaNet.forward = _patched_forward
+        _gdn._slime_packed_seq_patched = True
+
+        logger.info(
+            "slime GDN packed-sequence patch applied to "
+            "megatron.core.ssm.gated_delta_net.GatedDeltaNet "
+            "(cu_seqlens threaded into FLA conv1d + gated_delta_rule)."
+        )
+
+except ImportError as exc:
+    warnings.warn(
+        f"slime GDN packed-sequence patch not applied ({exc!r}). "
+        "Training a GDN/linear-attention model with --qkv-format thd will hit "
+        "Megatron's 'GDN does not support packed sequence' error; use "
+        "--qkv-format bshd as a fallback.",
+        stacklevel=2,
+    )
